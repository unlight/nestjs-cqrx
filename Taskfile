#!/bin/bash
PATH="$PWD/node_modules/.bin":$PATH
set -e

build() {
  set -x
  rm -rf dist
  tsdown

  NAME=$(jq -r '.name' package.json)
  ROOT=$(jq '{license, repository, bugs, homepage, keywords}' ../../package.json)

  mv "dist/index.js"   "dist/${NAME}.mjs"
  mv "dist/index.d.ts" "dist/${NAME}.d.ts"
  cp ../../README.md dist/README.md

  jq --argjson root "$ROOT" '
    del(.scripts, .devDependencies, .exports)
    | . * $root
    | .module  = "./\(.name).mjs"
    | .types   = "./\(.name).d.ts"
    | .exports = {
        ".": {
          types:   "./\(.name).d.ts",
          default: "./\(.name).mjs"
        }
      }
  ' package.json > dist/package.json
  set +x
}

release() {
  set -x
  if [ -z "$1" ]; then
    echo 'Missing folder package'
    exit 1;
  fi
  pushd $1
  npx semantic-release
  popd
  set +x
}

"$@"
