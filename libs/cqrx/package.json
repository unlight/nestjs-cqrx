{
  "name": "cqrx",
  "description": "Core cqrx library with aggregate root and event handling primitives, independent of any specific framework or database",
  "type": "module",
  "version": "0.0.0-dev",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "node-is-class": "^1.0.4"
  },
  "devDependencies": {
    "rxjs": "6 - 7",
    "simplytyped": "^3.3.0"
  },
  "peerDependencies": {
    "reflect-metadata": "0.X",
    "rxjs": "6 - 7"
  },
  "scripts": {
    "build": "sh ../../Taskfile buildMicrobundle6",
    "test": "npm run eslint && npm run tscheck && npm run test:r",
    "test:r": "vitest run",
    "test:cov": "vitest run --coverage",
    "eslint": "eslint src",
    "test:w": "vitest watch",
    "tscheck": "tsc --noEmit",
    "tscheck:w": "npm run tscheck -- --watch"
  }
}
