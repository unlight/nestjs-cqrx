{
  "name": "eventdbx-cqrx",
  "version": "0.0.0-dev",
  "description": "EventDBX adapter and integration with cqrx, used by higher-level modules like nestjs-cqrx",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "peerDependencies": {
    "cqrx-core": "*",
    "eventdbxjs": "1"
  },
  "devDependencies": {
    "cqrx-core": "*",
    "eventdbxjs": "1"
  },
  "scripts": {
    "build": "sh ../../Taskfile buildMicrobundle6",
    "test": "npm run eslint && npm run tscheck && npm run test:r",
    "test:r": "vitest run",
    "test:cov": "vitest run --coverage",
    "eslint": "eslint src",
    "test:w": "vitest watch",
    "tscheck": "tsc --noEmit",
    "tscheck:w": "npm run tscheck -- --watch"
  },
  "publishConfig": {
    "access": "public"
  }
}
