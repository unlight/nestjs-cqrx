{
  "name": "kurrentdb-cqrx",
  "type": "module",
  "version": "0.0.0-dev",
  "description": "KurrentDB (formerly EventStoreDB) adapter and integration with cqrx, used by higher-level modules like nestjs-cqrx",
  "exports": {
    ".": "./src/index.ts"
  },
  "peerDependencies": {
    "@kurrent/kurrentdb-client": "1",
    "cqrx-core": "*"
  },
  "devDependencies": {
    "@kurrent/kurrentdb-client": "1",
    "cqrx-core": "*"
  },
  "scripts": {
    "build": "sh ../../Taskfile build",
    "test": "npm run eslint && npm run tscheck && npm run test:r",
    "test:r": "vitest run",
    "test:cov": "vitest run --coverage",
    "eslint": "eslint src",
    "test:w": "vitest watch",
    "tscheck": "tsc --noEmit",
    "tscheck:w": "npm run tscheck -- --watch"
  },
  "publishConfig": {
    "access": "public"
  }
}
